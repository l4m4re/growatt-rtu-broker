# Example environment for docker-compose
# Copy to .env and adjust for your system

# Required: full by-path to inverter RS-485 adapter
INV_DEV=/dev/serial/by-path/<inverter-port>

# Required by docker-compose.yml. For a no-Shine legacy/cache deployment use
# docker/run_broker.sh or invoke growatt-broker directly instead.
SHINE_DEV=/dev/serial/by-path/<shine-x2-port>

# Keep the host /dev tree visible so USB re-enumeration can be recovered
# without recreating the broker container.
HOTPLUG_DEVICES=1
# legacy and cache can run without SHINE_DEV; cache+shine* requires it.
BROKER_MODE=legacy

# Optional overrides
# Default wiring uses 115200 baud; keep this value unless your hardware needs a
# different speed.
BAUD=115200
BYTES=8N1
# Per-side overrides (uncomment to use)
# INV_BAUD=9600
# INV_BYTES=8E1
# SHINE_BAUD=9600
# SHINE_BYTES=8E1

TCP_BIND=0.0.0.0:5020
TCP_ALT_BIND=0.0.0.0:5021
SNIFF_BIND=0.0.0.0:5700
MIN_PERIOD=1.0
RTIMEOUT=1.5
FC20_TIMEOUT=3.0
SHINE_BURST=8
SHINE_POLICY=read-only
LOG_PATH=-
