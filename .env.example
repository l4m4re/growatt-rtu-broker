# Example environment for the config-driven broker deployment
# Copy to .env and adjust for your system

# Required: reviewed installation JSON. It contains the device paths, baud
# rates, RTU timeout, reopen threshold, poll plan, and write policies.
CONFIG_PATH=/share/growatt-rtu-broker/configs/examples/growatt-min6000tl-xh-shinewilan-x2.json

# Keep the host /dev tree visible so USB re-enumeration can be recovered
# without recreating the broker container.
HOTPLUG_DEVICES=1

TCP_BIND=0.0.0.0:5020
TCP_ALT_BIND=0.0.0.0:5021
SNIFF_BIND=0.0.0.0:5700
LOG_PATH=-

# In setup mode, also set a writable export path.
# OPERATION_MODE=setup
# SETUP_EXPORT_PATH=/share/growatt-broker-x2.candidate.json
